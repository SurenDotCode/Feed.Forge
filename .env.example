# --- LLM (script + scene plan). Set at least one; first available wins, mock is last-resort fallback.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Visuals: "pollinations" (free, no key) or "pillow" (offline gradient cards)
IMAGE_PROVIDER=pollinations

# --- Voice (edge-tts is free, no key)
TTS_VOICE=en-US-AriaNeural

# --- Pipeline
DEFAULT_SCENES=5
WORKERS=2
DATA_DIR=./data

# --- Set to 1 to run the whole pipeline offline with no external calls (for testing)
FEEDFORGE_MOCK=0
