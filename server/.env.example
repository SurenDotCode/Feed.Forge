# ─── FeedForge backend ─────────────────────────────────────────────
# Copy to .env  (cp .env.example .env)  and fill in GOOGLE_API_KEY.

# REQUIRED — one Google AI Studio key powers research, script, images and voice
# Get it free: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Server
PORT=7860
FEEDFORGE_WORKERS=1
# Comma-separated origins allowed to call the API. Use your Vercel URL in production,
# e.g. https://feedforge.vercel.app   ("*" allows any origin)
FEEDFORGE_ALLOWED_ORIGINS=*

# Caption timing: whisper (precise, one-time ~460MB download — run `npm run prefetch`)
#                 estimate (no download, timed from the audio; slightly less precise)
FEEDFORGE_CAPTION_ALIGN=whisper

# Economy mode (default 1): ~2 text calls per video instead of ~18. Keep it on for
# free-tier keys. Set 0 for full quality (web research + critic revisions) on a billed key.
FEEDFORGE_ECONOMY=1

# Optional tuning
# Gemini models (Google retires old ones — change these if a job says a model is unavailable)
# Comma-separated = automatic fallback: free-tier quota is per model, so when one
# model runs out the next one is used.
FEEDFORGE_LLM_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.6-flash,gemini-3.5-flash,gemini-3.7-flash,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.8-flash
# FEEDFORGE_IMAGE_MODEL=gemini-3.1-flash-image-preview
FEEDFORGE_TTS_MODEL=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
# FEEDFORGE_PLATFORM=youtube          # youtube (≤60s) | instagram (≤90s) | tiktok
# FEEDFORGE_MUSIC=bundled             # bundled (free) | lyria (AI music, ~$0.08/video)
# FEEDFORGE_AI_VIDEO=0                # 1 = animate scenes with Veo (slow + expensive)
# FEEDFORGE_MAX_JOBS=50
# FEEDFORGE_DATA_DIR=./data

# Free stock photos/videos — used automatically when AI images are unavailable
# (e.g. image quota). Free key in 2 minutes: https://www.pexels.com/api/
PEXELS_API_KEY=
# PIXABAY_API_KEY=                    # optional second stock source
# FEEDFORGE_VISUALS=auto              # auto = AI images + stock fallback | stock = stock photos first
# TAVILY_API_KEY=                     # web search for research

# Offline smoke test without any key: npm run smoke  (or FEEDFORGE_MOCK=1)
# FEEDFORGE_MOCK=0
